{
  "name": "pricewatch-site",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/assemble.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/*.test.js\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "e2e": "npm run build && npm run typecheck:e2e && playwright test"
  },
  "overrides": {
    "playwright-core": "1.49.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "22.9.0",
    "typescript": "5.6.3"
  }
}
